      state.business.email = document.getElementById('business-email-input').value.trim() || 'ibanesizathusokuphila@gmail.com';
      state.business.logo = uploadedImages.companyLogo;
      logActivity('Storefront', 'Updated business details and supplier information');
      saveState();
      toast('Storefront details, supplier logos, and email saved.');
    }
    function openProductForm(product = null) { document.getElementById('edit-id').value = product?.id || ''; document.getElementById('product-name').value = product?.name || ''; document.getElementById('product-category').value = product?.category || 'Ubuntu Luxurious Goods'; document.getElementById('product-price').value = product?.price ?? ''; document.getElementById('product-quantity').value = product?.quantity ?? 10; document.getElementById('product-threshold').value = product?.threshold ?? 5; document.getElementById('product-description').value = product?.description || ''; uploadedImages.product = product?.image || ''; const preview = document.getElementById('product-image-preview'); preview.src = uploadedImages.product; preview.hidden = !uploadedImages.product; document.getElementById('product-image-file').value = ''; document.querySelector('#product-dialog h2').textContent = product ? 'Edit Product' : 'Add Product'; document.getElementById('product-dialog').hidden = false; }
    function closeProductForm() { document.getElementById('product-dialog').hidden = true; }
    function saveProduct(event) { event.preventDefault(); const id = document.getElementById('edit-id').value; const product = { id: id || 'p-' + Date.now(), name: document.getElementById('product-name').value.trim(), category: document.getElementById('product-category').value, price: Number(document.getElementById('product-price').value), quantity: Number(document.getElementById('product-quantity').value), threshold: Number(document.getElementById('product-threshold').value), description: document.getElementById('product-description').value.trim(), image: uploadedImages.product }; if (id) state.products = state.products.map(p => p.id === id ? product : p); else state.products.unshift(product); logActivity('Inventory', `${id ? 'Updated' : 'Added'} ${product.name}`); closeProductForm(); saveState(); toast(id ? 'Product updated.' : 'Product added to stock.'); }
    function editProduct(id) { const product = state.products.find(p => p.id === id); if (product) openProductForm(product); }
    function adjustStock(id, delta) { const product = state.products.find(p => p.id === id); if (!product) return; product.quantity = Math.max(0, product.quantity + delta); logActivity('Inventory', `${product.name}: stock is now ${product.quantity}`); saveState(); }
    function removeProduct(id) { const product = state.products.find(p => p.id === id); if (!product || !confirm(`Remove ${product.name} from the catalog?`)) return; state.products = state.products.filter(p => p.id !== id); delete cart[id]; logActivity('Inventory', `Removed ${product.name}`); saveState(); toast('Product removed.'); }
    function setOrderStatus(id, status) { const order = state.orders.find(o => o.id === id); if (order) { order.status = status; logActivity('Order', `${order.id} marked ${status}`); saveState(); } }
    function renderAdminContentFields() {
      document.getElementById('business-name-input').value = state.business.name || 'Ibanesizathusokuphila';
      document.getElementById('business-tagline-input').value = state.business.tagline || '';
      document.getElementById('business-phone-input').value = state.business.phone || '0785335134';
      document.getElementById('business-announcement-input').value = state.business.announcement || '';
      document.getElementById('business-email-input').value = state.business.email || 'ibanesizathusokuphila@gmail.com';
      document.getElementById('company-logo-file').value = '';
      document.getElementById('company-logo-preview').hidden = !state.business.logo;
      if (state.business.logo) document.getElementById('company-logo-preview').src = state.business.logo;
      renderAdvertisementList();
      [1, 2].forEach((number, index) => {
        const supplier = state.suppliers[index] || {};
        document.getElementById(`supplier-name-${number}`).value = supplier.name || '';
        const preview = document.getElementById(`supplier-preview-${number}`);
        preview.hidden = !supplier.image;
        if (supplier.image) preview.src = supplier.image;
      });
    }
    function renderAll() { renderCategories(); renderProducts(); renderCart(); renderAdmin(); renderAdminContentFields(); renderStorefrontExtras(); }
    refreshAdminLock();
    let installPromptEvent;
    window.addEventListener('beforeinstallprompt', event => {
      event.preventDefault();
      installPromptEvent = event;
      document.getElementById('install-app').hidden = false;
    });
    document.getElementById('install-app').addEventListener('click', async () => {
      if (!installPromptEvent) return;
      installPromptEvent.prompt();
      await installPromptEvent.userChoice;
      installPromptEvent = null;
      document.getElementById('install-app').hidden = true;
    });
    window.addEventListener('appinstalled', () => { document.getElementById('install-app').hidden = true; });
    if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost')) {
      window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(error => console.warn('Offline app support could not be enabled.', error)));
    }
    renderAll();
  </script>
</body>
</html>
